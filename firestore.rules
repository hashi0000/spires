rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Admin dashboard accounts — add staff emails here
    function isAdmin() {
      return isAuthenticated()
        && request.auth.token.email.lower() in [
          'spirestaxis24@gmail.com',
          'hashim@spires.com'
        ];
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    match /customers/{userId} {
      allow read, write: if isOwner(userId);
      allow read: if isAdmin();
    }

    match /bookings/{bookingId} {
      // Admin dashboard — full access
      allow read, write: if isAdmin();

      // Customer app — own bookings only
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isAuthenticated()
        && resource.data.uid == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    match /drivers/{driverId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /vehicles/{vehicleId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // School invoice vault: ciphertext only, written by Cloud Functions (Admin SDK).
    match /schoolInvoiceVault/{docId} {
      allow read, write: if false;
    }

    // Spires Share is admin-SDK only (Cloud Functions). Never public client access.
    match /spiresShareConfig/{docId} {
      allow read, write: if false;
    }
    match /spiresShareJourneys/{docId} {
      allow read, write: if false;
    }
    match /spiresShareBookings/{docId} {
      allow read, write: if false;
    }
    match /spiresShareWaitlist/{docId} {
      allow read, write: if false;
    }
    match /spiresShareAudit/{docId} {
      allow read, write: if false;
    }
    match /spiresSharePayments/{docId} {
      allow read, write: if false;
    }
    match /spiresShareSlots/{docId} {
      allow read, write: if false;
    }
    match /spiresShareIdempotency/{docId} {
      allow read, write: if false;
    }
    match /spiresShareNotifications/{docId} {
      allow read, write: if false;
    }
    match /spiresShareDropoffHubs/{docId} {
      allow read, write: if false;
    }
    match /spiresShareInterestGroups/{docId} {
      allow read, write: if false;
    }
    match /spiresShareInterestEntries/{docId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
