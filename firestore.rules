rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Full admin (invoices, school vault access via functions, customer records).
    function isAdmin() {
      return isAuthenticated()
        && request.auth.token.email.lower() in [
          'spirestaxis24@gmail.com',
          'hashim@spires.com'
        ];
    }

    // Office email accounts (admin app). Keep in sync with FAMILY_STAFF_EMAILS / ADMIN_EMAILS.
    function isStaff() {
      return isAuthenticated()
        && request.auth.token.email.lower() in [
          'spirestaxis24@gmail.com',
          'hashim@spires.com'
        ];
    }

    // Remembered family phones. UID is minted by unlockFamilyJobs after a server PIN check.
    function isFamilyDevice() {
      return isAuthenticated()
        && request.auth.token.familyJobs == true
        && exists(/databases/$(database)/documents/familyDevices/$(request.auth.uid))
        && get(/databases/$(database)/documents/familyDevices/$(request.auth.uid)).data.enabled == true
        && get(/databases/$(database)/documents/familyDevices/$(request.auth.uid)).data.expiresAt > request.time;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    match /customers/{userId} {
      allow read, write: if isOwner(userId);
      allow read: if isAdmin();
    }

    match /familyDevices/{deviceId} {
      allow read: if isAuthenticated() && request.auth.uid == deviceId;
      allow write: if false;
    }

    match /familyJobsUnlockAttempts/{docId} {
      allow read, write: if false;
    }

    match /bookings/{bookingId} {
      // Office emails and PIN-authorised family devices — shared live calendar
      allow read, write: if isStaff() || isFamilyDevice();

      // Customer app — own bookings only. Customers cannot set payment, quote or promotion fields.
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && !request.resource.data.keys().hasAny(['createdByFunction', 'promotion', 'issuedQuote', 'quoteIssuedVersion', 'quoteAcceptedVersion', 'paymentLinkUrl', 'amountReceivedPence', 'termsAcceptanceRecordedAt', 'termsAcceptanceRecordedBy', 'termsAcceptanceNote'])
        && request.resource.data.termsAccepted == true
        && request.resource.data.termsVersion == '2026-10-25'
        && request.resource.data.acceptanceMethod == 'customer_portal'
        && request.resource.data.termsAcceptedAt == request.time
        && (!('paymentStatus' in request.resource.data) || request.resource.data.paymentStatus == 'pending');
      allow update: if isAuthenticated()
        && resource.data.uid == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'phone', 'pickup', 'destination', 'dateTime', 'passengers', 'luggage',
          'specialRequirements', 'notes', 'flightNumber', 'terminal', 'vehicleType',
          'bookingType', 'returnTrip', 'returnDateTime', 'returnPickupTime',
          'returnPickupLocation', 'returnDestination', 'airportCollection',
          'returnAirportCollection', 'returnFlightNumber', 'paymentMethod', 'updatedAt',
          'name', 'email'
        ]);
      allow delete: if false;

      match /audit/{auditId} {
        allow read, write: if false;
      }
    }

    match /emailJobs/{jobId} {
      allow read, write: if false;
    }

    match /quoteTokens/{tokenId} {
      allow read, write: if false;
    }

    match /termsTokens/{tokenId} {
      allow read, write: if false;
    }

    match /drivers/{driverId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /vehicles/{vehicleId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // School invoice vault: ciphertext only, written by Cloud Functions (Admin SDK).
    match /schoolInvoiceVault/{docId} {
      allow read, write: if false;
    }

    // Spires Share is admin-SDK only (Cloud Functions). Never public client access.
    match /spiresShareConfig/{docId} {
      allow read, write: if false;
    }
    match /spiresShareJourneys/{docId} {
      allow read, write: if false;
    }
    match /spiresShareBookings/{docId} {
      allow read, write: if false;
    }
    match /spiresShareWaitlist/{docId} {
      allow read, write: if false;
    }
    match /spiresShareAudit/{docId} {
      allow read, write: if false;
    }
    match /spiresSharePayments/{docId} {
      allow read, write: if false;
    }
    match /spiresShareSlots/{docId} {
      allow read, write: if false;
    }
    match /spiresShareIdempotency/{docId} {
      allow read, write: if false;
    }
    match /spiresShareNotifications/{docId} {
      allow read, write: if false;
    }
    match /spiresShareDropoffHubs/{docId} {
      allow read, write: if false;
    }
    match /spiresShareInterestGroups/{docId} {
      allow read, write: if false;
    }
    match /spiresShareInterestEntries/{docId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
