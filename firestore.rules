rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Full admin (invoices, school vault access via functions, customer records).
    function isAdmin() {
      return isAuthenticated()
        && request.auth.token.email.lower() in [
          'spirestaxis24@gmail.com',
          'hashim@spires.com'
        ];
    }

    // Office email accounts (admin app). Keep in sync with FAMILY_STAFF_EMAILS / ADMIN_EMAILS.
    function isStaff() {
      return isAuthenticated()
        && request.auth.token.email.lower() in [
          'spirestaxis24@gmail.com',
          'hashim@spires.com'
        ];
    }

    // Remembered family phones. UID is minted by unlockFamilyJobs after a server PIN check.
    function isFamilyDevice() {
      return isAuthenticated()
        && request.auth.token.familyJobs == true
        && exists(/databases/$(database)/documents/familyDevices/$(request.auth.uid))
        && get(/databases/$(database)/documents/familyDevices/$(request.auth.uid)).data.enabled == true
        && get(/databases/$(database)/documents/familyDevices/$(request.auth.uid)).data.expiresAt > request.time;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    match /customers/{userId} {
      allow read, write: if isOwner(userId);
      allow read: if isAdmin();
    }

    match /familyDevices/{deviceId} {
      allow read: if isAuthenticated() && request.auth.uid == deviceId;
      allow write: if false;
    }

    match /familyJobsUnlockAttempts/{docId} {
      allow read, write: if false;
    }

    function familyOperationalKeys() {
      return [
        'bookingNumber', 'dateTime', 'pickupTime', 'pickupLocation', 'destination',
        'hirerName', 'hirerPhone', 'hirerAddress', 'bookingMethod', 'bookingType',
        'vehicleType', 'status', 'adminStatus', 'flightNumber', 'notes', 'source',
        'createdByEmail', 'createdByUid', 'updatedByEmail', 'updatedByUid',
        'driverId', 'vehicleId', 'returnDriverId', 'returnVehicleId', 'allocatedTime', 'actualFare', 'cancelledAt', 'cancelledByEmail',
        'cancelledByUid', 'customerStatus', 'createdAt', 'updatedAt', 'revision',
        'outboundStatus', 'returnStatus',
        'outboundCompletedAt', 'outboundCompletedByUid',
        'returnCompletedAt', 'returnCompletedByUid',
        'outboundDriverReadyAt', 'outboundPassengerReadyAt', 'outboundPassengerOnboardAt', 'outboundDepartedAt', 'outboundDelayCause',
        'returnDriverReadyAt', 'returnPassengerReadyAt', 'returnPassengerOnboardAt', 'returnDepartedAt', 'returnDelayCause'
      ];
    }

    function familyChanged() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function bookingHasReturn() {
      return resource.data.get('bookingType', '') == 'return'
        || resource.data.get('returnTrip', false) == true
        || resource.data.get('openReturn', false) == true
        || resource.data.get('returnPickupTime', '') != ''
        || resource.data.get('returnDateTime', '') != '';
    }

    function assignedDriver(field) {
      return resource.data.get(field, '') is string
        && resource.data.get(field, '').size() > 0;
    }

    function familyLegWrite(field, atField, byField, driverOk, otherCompleted) {
      return !familyChanged().hasAny([field])
        || (
          resource.data.get(field, '') != 'completed'
          && resource.data.status != 'cancelled'
          && resource.data.get('customerStatus', '') != 'cancelled'
          && resource.data.get(field, resource.data.status) != 'cancelled'
          && (
            (
              request.resource.data[field] == 'completed'
              && driverOk
              && request.resource.data[atField] == request.time
              && request.resource.data[byField] == request.auth.uid
            )
            || (
              request.resource.data[field] in ['confirmed', 'allocated']
              && otherCompleted
            )
          )
        );
    }

    function familyStatusWriteOk() {
      return familyLegWrite(
          'outboundStatus', 'outboundCompletedAt', 'outboundCompletedByUid',
          assignedDriver('driverId'),
          request.resource.data.returnStatus == 'completed' && request.resource.data.returnCompletedAt == request.time
        )
        && familyLegWrite(
          'returnStatus', 'returnCompletedAt', 'returnCompletedByUid',
          assignedDriver('returnDriverId'),
          request.resource.data.outboundStatus == 'completed' && request.resource.data.outboundCompletedAt == request.time
        )
        && (
          !familyChanged().hasAny(['status'])
          || request.resource.data.status != 'completed'
          || (
            resource.data.status != 'cancelled'
            && resource.data.get('customerStatus', '') != 'cancelled'
            && request.resource.data.outboundStatus == 'completed'
            && request.resource.data.outboundCompletedByUid == request.auth.uid
            && (
              !bookingHasReturn()
              || request.resource.data.returnStatus == 'completed'
              || request.resource.data.returnStatus == 'cancelled'
            )
          )
        )
        && (
          resource.data.status != 'completed'
          || request.resource.data.status == 'completed'
        );
    }

    match /bookings/{bookingId} {
      // Office accounts keep the full booking record.
      allow read: if isStaff() || isFamilyDevice();
      allow create: if isStaff() && request.resource.data.revision == 1;
      allow update: if isStaff()
        && request.resource.data.revision == resource.data.get('revision', 0) + 1;
      allow delete: if isStaff();

      // Family phones can read the shared calendar and change the journey they operate.
      // They cannot write payment ledger, ownership, quote, acceptance or audit fields.
      allow create: if isFamilyDevice()
        && request.resource.data.source == 'family'
        && request.resource.data.revision == 1
        && request.resource.data.keys().hasOnly(familyOperationalKeys());
      allow update: if isFamilyDevice()
        && request.resource.data.revision == resource.data.get('revision', 0) + 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(familyOperationalKeys())
        && familyStatusWriteOk()
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['actualFare'])
          || resource.data.source == 'family'
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['customerStatus'])
          || (request.resource.data.status == 'cancelled' && request.resource.data.customerStatus == 'cancelled')
          || (
            request.resource.data.customerStatus == request.resource.data.status
            && request.resource.data.status in ['confirmed', 'allocated', 'completed', 'pending']
            && resource.data.status != 'cancelled'
          )
        );

      // Customer app — own bookings only. Customers cannot set payment, quote or promotion fields.
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && !request.resource.data.keys().hasAny(['createdByFunction', 'promotion', 'issuedQuote', 'quoteIssuedVersion', 'quoteAcceptedVersion', 'paymentLinkUrl', 'amountReceivedPence', 'termsAcceptanceRecordedAt', 'termsAcceptanceRecordedBy', 'termsAcceptanceNote', 'brand', 'fareApproved', 'internationalFarePence', 'executiveAvailability', 'proposedFarePounds'])
        && (!('vehicleType' in request.resource.data) || request.resource.data.vehicleType != 'executive')
        && (!('serviceType' in request.resource.data) || request.resource.data.serviceType != 'executive')
        && request.resource.data.termsAccepted == true
        && request.resource.data.termsVersion == '2026-11-19'
        && request.resource.data.acceptanceMethod == 'customer_portal'
        && request.resource.data.termsAcceptedAt == request.time
        && (!('paymentStatus' in request.resource.data) || request.resource.data.paymentStatus == 'pending');
      allow update: if isAuthenticated()
        && resource.data.uid == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.uid == resource.data.uid
        && (!('vehicleType' in request.resource.data) || request.resource.data.vehicleType != 'executive' || resource.data.vehicleType == 'executive')
        && (!('serviceType' in request.resource.data) || request.resource.data.serviceType != 'executive' || resource.data.serviceType == 'executive')
        && request.resource.data.revision == resource.data.get('revision', 0) + 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'phone', 'pickup', 'destination', 'dateTime', 'passengers', 'luggage',
          'specialRequirements', 'notes', 'flightNumber', 'terminal', 'vehicleType',
          'bookingType', 'returnTrip', 'returnDateTime', 'returnPickupTime',
          'returnPickupLocation', 'returnDestination', 'airportCollection',
          'returnAirportCollection', 'returnFlightNumber', 'paymentMethod', 'updatedAt',
          'name', 'email', 'revision'
        ]);
      allow delete: if false;

      match /audit/{auditId} {
        allow read: if isStaff();
        allow create: if isStaff()
          && request.resource.data.action == 'leg_completion_undone'
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.at == request.time
          && request.resource.data.leg in ['outbound', 'return'];
        allow update, delete: if false;
      }
    }

    match /emailJobs/{jobId} {
      allow read, write: if false;
    }

    match /quoteTokens/{tokenId} {
      allow read, write: if false;
    }

    match /termsTokens/{tokenId} {
      allow read, write: if false;
    }

    match /drivers/{driverId} {
      allow read: if isStaff() || isFamilyDevice();
      allow write: if isAdmin();
    }

    match /vehicles/{vehicleId} {
      allow read: if isStaff() || isFamilyDevice();
      allow write: if isAdmin();
    }

    match /companyPlaces/{placeId} {
      allow read, write: if isStaff();
    }

    // School invoice vault: ciphertext only, written by Cloud Functions (Admin SDK).
    match /schoolInvoiceVault/{docId} {
      allow read, write: if false;
    }

    // Spires Share is admin-SDK only (Cloud Functions). Never public client access.
    match /spiresShareConfig/{docId} {
      allow read, write: if false;
    }
    match /spiresShareJourneys/{docId} {
      allow read, write: if false;
    }
    match /spiresShareBookings/{docId} {
      allow read, write: if false;
    }
    match /spiresShareWaitlist/{docId} {
      allow read, write: if false;
    }
    match /spiresShareAudit/{docId} {
      allow read, write: if false;
    }
    match /spiresSharePayments/{docId} {
      allow read, write: if false;
    }
    match /spiresShareSlots/{docId} {
      allow read, write: if false;
    }
    match /spiresShareIdempotency/{docId} {
      allow read, write: if false;
    }
    match /spiresShareNotifications/{docId} {
      allow read, write: if false;
    }
    match /spiresShareDropoffHubs/{docId} {
      allow read, write: if false;
    }
    match /spiresShareInterestGroups/{docId} {
      allow read, write: if false;
    }
    match /spiresShareInterestEntries/{docId} {
      allow read, write: if false;
    }

    match /marketingSpend/{entryId} {
      allow read, write: if isAdmin();
    }

    match /marketingSpendSettings/{docId} {
      allow read, write: if isAdmin();
    }

    match /bookingMeasurementNotes/{bookingId} {
      allow read, write: if isAdmin();
    }

    match /marketingConversions/{conversionId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /stripePaymentClaims/{paymentIntentId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
