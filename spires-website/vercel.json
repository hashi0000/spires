{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/terms-and-conditions",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "spires-taxis.com" }],
      "destination": "https://www.spires-taxis.com/:path*",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "booking.spires-taxis.com" }],
      "destination": "https://customer.spires-taxis.com/:path*",
      "statusCode": 301
    },
    {
      "source": "/pages/oxford-to-heathrow-taxi",
      "destination": "/oxford-to-heathrow-taxi",
      "statusCode": 301
    },
    {
      "source": "/station-transfers",
      "destination": "/airport-transfers",
      "statusCode": 301
    },
    {
      "source": "/student-offers",
      "destination": "/student-taxis",
      "statusCode": 301
    },
    {
      "source": "/pages/heathrow-airport",
      "destination": "/oxford-to-heathrow-taxi",
      "statusCode": 301
    },
    {
      "source": "/destinations/airport-transfers",
      "destination": "/airport-transfers",
      "statusCode": 301
    },
    {
      "source": "/destinations/attractions/bicester-village",
      "destination": "/bicester-taxis",
      "statusCode": 301
    },
    {
      "source": "/destinations/:path*",
      "destination": "/airport-transfers",
      "statusCode": 301
    },
    {
      "source": "/pages/:path*",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/booking",
      "destination": "https://customer.spires-taxis.com",
      "statusCode": 301
    },
    {
      "source": "/login",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/admin",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/admin/:path*",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/services.html",
      "destination": "/airport-transfers",
      "statusCode": 301
    },
    {
      "source": "/services",
      "destination": "/airport-transfers",
      "statusCode": 301
    },
    {
      "source": "/destinations",
      "destination": "/airport-transfers",
      "statusCode": 301
    },
    {
      "source": "/airport-taxis-oxford",
      "destination": "/airport-transfers",
      "statusCode": 301
    },
    {
      "source": "/abingdon-taxi",
      "destination": "/abingdon-taxis",
      "statusCode": 301
    },
    {
      "source": "/heathrow-airport-taxis",
      "destination": "/oxford-to-heathrow-taxi",
      "statusCode": 301
    },
    {
      "source": "/gatwick-airport-taxis",
      "destination": "/oxford-to-gatwick-taxi",
      "statusCode": 301
    },
    {
      "source": "/birmingham-airport-taxis",
      "destination": "/airport-transfers",
      "statusCode": 301
    },
    {
      "source": "/index.html",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/nav-snippet",
      "destination": "/",
      "statusCode": 301
    }
  ]
}
